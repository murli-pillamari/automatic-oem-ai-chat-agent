# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Override this with /app/data/crm_agent.db in Docker.
SQLITE_DB_PATH=./data/crm_agent.db

# Google AI Studio. Set a supported Flash model for your account.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-2.5-flash
# Hard timeout for each Gemini sendMessage request.
GEMINI_REQUEST_TIMEOUT_MS=45000

# Optional: when set, Groq is used instead of Gemini via its OpenAI-compatible API.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REQUEST_TIMEOUT_MS=15000

# Zoho OAuth server-to-server credentials. Keep disabled for a local demo.
ZOHO_ENABLED=false
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Zoho data-centre suffix: com, eu, in, com.au, jp, or ca.
# `in` resolves to accounts.zoho.in and www.zohoapis.in.
ZOHO_DC=in
